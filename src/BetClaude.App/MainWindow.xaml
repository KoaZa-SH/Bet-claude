<Window x:Class="BetClaude.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:BetClaude.App.Localization"
        Title="{Binding [AppTitle], Source={x:Static loc:Loc.Instance}}"
        Width="1180" Height="760" MinWidth="960" MinHeight="600"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FlowDirection="{Binding Flow, Source={x:Static loc:Loc.Instance}}"
        FontFamily="Vazirmatn, Segoe UI, Tahoma"
        FontSize="14">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Navigation -->
    <Border Grid.Column="0" Grid.RowSpan="2" Background="{DynamicResource CardBrush}" Padding="12,20">
      <StackPanel>
        <TextBlock Text="BetClaude" FontSize="22" FontWeight="SemiBold" Margin="14,0,0,20" />
        <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Dashboard"
                Content="{Binding [Dashboard], Source={x:Static loc:Loc.Instance}}" />
        <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Matches"
                Content="{Binding [Matches], Source={x:Static loc:Loc.Instance}}" />
        <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Data"
                Content="{Binding [DataCollection], Source={x:Static loc:Loc.Instance}}" />
        <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Settings"
                Content="{Binding [Settings], Source={x:Static loc:Loc.Instance}}" />
      </StackPanel>
    </Border>

    <!-- Pages -->
    <Grid Grid.Column="1" Grid.Row="0" Margin="28,24">

      <!-- Dashboard -->
      <StackPanel Visibility="{Binding IsDashboardPage, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Text="{Binding [Dashboard], Source={x:Static loc:Loc.Instance}}" FontSize="26" FontWeight="SemiBold" />
        <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="18" Margin="0,18,0,0"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
          <TextBlock Text="{Binding [Disclaimer], Source={x:Static loc:Loc.Instance}}" TextWrapping="Wrap" />
        </Border>
        <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="18" Margin="0,14,0,0"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
          <StackPanel>
            <TextBlock Text="{Binding [StoredCompetitions], Source={x:Static loc:Loc.Instance}}"
                       Foreground="{DynamicResource MutedBrush}" />
            <TextBlock Text="{Binding StoredCompetitions}" FontSize="18" Margin="0,4,0,12" TextWrapping="Wrap" />
            <TextBlock Text="{Binding [DatabaseLocation], Source={x:Static loc:Loc.Instance}}"
                       Foreground="{DynamicResource MutedBrush}" />
            <TextBlock Text="{Binding DbPath}" TextWrapping="Wrap" FlowDirection="LeftToRight" Margin="0,4,0,0" />
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- Matches and analysis -->
      <Grid Visibility="{Binding IsMatchesPage, Converter={StaticResource BoolToVisibility}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="1.2*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="14" Margin="0,0,14,0"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Button Grid.Row="0" Style="{StaticResource AccentButton}" Command="{Binding LoadFixturesCommand}"
                    Content="{Binding [LoadFixtures], Source={x:Static loc:Loc.Instance}}" Margin="0,0,0,12" />
            <ListBox Grid.Row="1" ItemsSource="{Binding Fixtures}" SelectedItem="{Binding SelectedFixture}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Display}" Margin="4,6" TextWrapping="Wrap" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>

        <Border Grid.Column="1" Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="18"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
          <Grid>
            <TextBlock Text="{Binding [SelectMatch], Source={x:Static loc:Loc.Instance}}"
                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                       Visibility="{Binding HasNoAnalysis, Converter={StaticResource BoolToVisibility}}" />
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding HasAnalysis, Converter={StaticResource BoolToVisibility}}">
              <StackPanel>
                <TextBlock Text="{Binding AnalysisHeader}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding QualityText}" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ValidationText}" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                <TextBlock Text="{Binding WarningsText}" Margin="0,8,0,0" TextWrapping="Wrap" />
                <TextBlock Text="{Binding NoteText}" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding Rows}" Margin="0,14,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="210" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="64" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Label}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}" Height="8"
                                     Margin="8,0" Foreground="{DynamicResource AccentBrush}"
                                     Background="{DynamicResource BorderBrush}" BorderThickness="0" />
                        <TextBlock Grid.Column="2" Text="{Binding Text}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   FlowDirection="LeftToRight" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>

      <!-- Data collection -->
      <StackPanel Visibility="{Binding IsDataPage, Converter={StaticResource BoolToVisibility}}" MaxWidth="560" HorizontalAlignment="Left">
        <TextBlock Text="{Binding [DataCollection], Source={x:Static loc:Loc.Instance}}" FontSize="26" FontWeight="SemiBold" />
        <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="18" Margin="0,18,0,0"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
          <StackPanel>
            <TextBlock Text="{Binding [Competition], Source={x:Static loc:Loc.Instance}}" Foreground="{DynamicResource MutedBrush}" />
            <TextBox Text="{Binding ImportCompetition, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" FlowDirection="LeftToRight" />
            <TextBlock Text="{Binding [Season], Source={x:Static loc:Loc.Instance}}" Foreground="{DynamicResource MutedBrush}" />
            <TextBox Text="{Binding ImportSeason, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" FlowDirection="LeftToRight" />
            <TextBlock Text="{Binding [ImportHint], Source={x:Static loc:Loc.Instance}}" Foreground="{DynamicResource MutedBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,14" />
            <Button Style="{StaticResource AccentButton}" Command="{Binding ImportCommand}"
                    Content="{Binding [ImportButton], Source={x:Static loc:Loc.Instance}}" HorizontalAlignment="Left" />
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- Settings -->
      <StackPanel Visibility="{Binding IsSettingsPage, Converter={StaticResource BoolToVisibility}}" MaxWidth="560" HorizontalAlignment="Left">
        <TextBlock Text="{Binding [Settings], Source={x:Static loc:Loc.Instance}}" FontSize="26" FontWeight="SemiBold" />
        <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="18" Margin="0,18,0,0"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
          <StackPanel>
            <TextBlock Text="{Binding [Language], Source={x:Static loc:Loc.Instance}}" Foreground="{DynamicResource MutedBrush}" />
            <RadioButton GroupName="Lang" Content="English" IsChecked="{Binding IsEnglish, Mode=TwoWay}" />
            <RadioButton GroupName="Lang" Content="فارسی" IsChecked="{Binding IsPersian, Mode=TwoWay}" />
            <CheckBox Content="{Binding [Theme], Source={x:Static loc:Loc.Instance}}" IsChecked="{Binding IsDark, Mode=TwoWay}" Margin="0,14,0,0" />
          </StackPanel>
        </Border>
        <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="18" Margin="0,14,0,0"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
          <StackPanel>
            <TextBlock Text="{Binding [ApiKey], Source={x:Static loc:Loc.Instance}}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
            <PasswordBox x:Name="ApiKeyBox" Margin="0,6,0,10" FlowDirection="LeftToRight" />
            <Button Style="{StaticResource AccentButton}" Click="SaveKey_Click" HorizontalAlignment="Left"
                    Content="{Binding [SaveKey], Source={x:Static loc:Loc.Instance}}" />
          </StackPanel>
        </Border>
      </StackPanel>

    </Grid>

    <!-- Status bar -->
    <Border Grid.Column="1" Grid.Row="1" Padding="28,10" Background="{DynamicResource CardBrush}">
      <StackPanel>
        <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,6" BorderThickness="0"
                     Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource BorderBrush}"
                     Visibility="{Binding Busy, Converter={StaticResource BoolToVisibility}}" />
        <TextBlock Text="{Binding Status}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
